# Provedor usado por build_llm: fake (padrão, offline), openai ou anthropic.
# evaluate-defenses só chama um provedor real com --allow-live e com a chave
# e o modelo preenchidos. Sem isso o processo termina sem fazer a chamada.
LLM_PROVIDER=fake

# Deixe vazio. Nunca commite chaves reais.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Usados só em chamada ao vivo. Sobrescreva se o snapshot mudar.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
